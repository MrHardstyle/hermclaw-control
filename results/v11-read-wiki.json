    "content": "<?php\n/*\nICON: book-open\nTITLE: Wiki\nPRIO: 30\nBEREICH: work\nRECHT: wiki_anzeigen\nURL: wiki.php\n*/\n?>\n<?php\n$wiki_ansicht = preg_replace('/[^a-z_]/', '', strtolower((string)($_GET['ansicht'] ?? 'start')));\n$meldung = '';\n\nif ($_SERVER['REQUEST_METHOD'] === 'POST') {\n    csrf_schutz_pruefen();\n    $aktion = (string)($_POST['aktion'] ?? '');\n\n    if ($aktion === 'artikel_speichern') {\n        $artikel_id = wiki_artikel_speichern($_POST);\n        if ($artikel_id > 0 && isset($_FILES['anhang']) && (int)($_FILES['anhang']['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_NO_FILE) {\n            wiki_anhang_speichern($artikel_id, $_FILES['anhang']);\n        }\n        header('Location: index.php?seite=work_wiki&ansicht=' . ($artikel_id > 0 ? 'artikel&id=' . $artikel_id . '&meldung=gespeichert' : 'editor&meldung=fehler'));\n        exit;\n    }\n\n    if ($aktion === 'kategorie_speichern') {\n        $kategorie_id = wiki_kategorie_speichern($_POST);\n        header('Location: index.php?seite=work_wiki&ansicht=kategorien&meldung=' . ($kategorie_id > 0 ? 'kategorie' : 'fehler'));\n        exit;\n    }\n\n    if ($aktion === 'artikel_archivieren') {\n        wiki_artikel_archivieren((int)($_POST['id'] ?? 0));\n        header('Location: index.php?seite=work_wiki&meldung=archiviert');\n        exit;\n    }\n\n    if ($aktion === 'anhang_archivieren') {\n        wiki_anhang_archivieren((int)($_POST['id'] ?? 0));\n        header('Location: index.php?seite=work_wiki&ansicht=artikel&id=' . (int)($_POST['artikel_id'] ?? 0) . '&meldung=anhang');\n        exit;\n    }\n\n    if ($aktion === 'version_wiederherstellen') {\n        $artikel_id = wiki_version_wiederherstellen((int)($_POST['version_id'] ?? 0));\n        header('Location: index.php?seite=work_wiki&ansicht=' . ($artikel_id > 0 ? 'artikel&id=' . $artikel_id . '&meldung=wiederhergestellt' : 'versionen&meldung=fehler'));\n        exit;\n    }\n}\n\n$meldungen = [\n    'gespeichert' => ['erfolg', 'Artikel wurde gespeichert.'],\n    'kategorie' => ['erfolg', 'Kategorie wurde gespeichert.'],\n    'archiviert' => ['erfolg', 'Artikel wurde archiviert.'],\n    'anhang' => ['erfolg', 'Anhang wurde archiviert.'],\n    'wiederhergestellt' => ['erfolg', 'Version wurde wiederhergestellt.'],\n    'fehler' => ['fehler', 'Die Aktion konnte nicht abgeschlossen werden.'],\n];\n$meldung_key = (string)($_GET['meldung'] ?? '');\n?>\n\n<section class=\"seitenkopf wiki-kopf\">\n    <div>\n        <p class=\"seitenkopf__eyebrow\">Work</p>\n        <h1>Wiki</h1>\n        <p>Strukturierte Wissensbasis fuer Benutzer, Betrieb und spaetere KI-Agenten.</p>\n    </div>\n    <div class=\"wiki-kopf__aktionen\">\n        <?php if (rechte_pruefen('wiki_artikel_anlegen')): ?>\n            <a class=\"button button--primaer\" href=\"index.php?seite=work_wiki&ansicht=editor\">Neuer Artikel</a>\n        <?php endif; ?>\n        <a class=\"button button--sekundaer\" href=\"index.php?seite=work_wiki&ansicht=suche\">Suche</a>\n        <a class=\"button button--sekundaer\" href=\"index.php?seite=work_wiki\">Uebersicht</a>\n    </div>\n</section>\n\n<?php if (isset($meldungen[$meldung_key])): ?>\n    <section class=\"meldung meldung--<?= ausgabe($meldungen[$meldung_key][0]) ?>\"><?= ausgabe($meldungen[$meldung_key][1]) ?></section>\n<?php endif; ?>\n\n<?php if ($wiki_ansicht === 'start'): ?>\n    <?php\n    $kategorien = wiki_kategorien_laden();\n    $artikel = wiki_artikel_liste();\n    $angepinnt = array_values(array_filter($artikel, static fn(array $eintrag): bool => (int)$eintrag['angepinnt'] === 1));\n    $neueste = array_slice($artikel, 0, 8);\n    $entwuerfe = array_values(array_filter($artikel, static fn(array $eintrag): bool => (string)$eintrag['status'] === 'entwurf'));\n    $veroeffentlicht = array_values(array_filter($artikel, static fn(array $eintrag): bool => (string)$eintrag['status'] === 'veroeffentlicht'));\n    ?>\n    <section class=\"wiki-kommandoleiste panel\">\n        <form class=\"wiki-suche\" action=\"index.php\" method=\"get\">\n            <input type=\"hidden\" name=\"seite\" value=\"work_wiki\">\n            <input type=\"hidden\" name=\"ansicht\" value=\"suche\">\n            <label for=\"wiki-start-suche\">Wiki durchsuchen</label>\n            <div class=\"wiki-suche__zeile\">\n                <input id=\"wiki-start-suche\" name=\"q\" type=\"search\" placeholder=\"Artikel, Inhalte, Kategorien oder Dateien suchen\">\n                <button class=\"button button--primaer\" type=\"submit\">Suchen</button>\n            </div>\n        </form>\n        <div class=\"wiki-kennzahlen\">\n            <article class=\"wiki-kennzahl\">\n                <span>Artikel</span>\n                <strong><?= count($artikel) ?></strong>\n            </article>\n            <article class=\"wiki-kennzahl\">\n                <span>Kategorien</span>\n                <strong><?= count($kategorien) ?></strong>\n            </article>\n            <article class=\"wiki-kennzahl\">\n                <span>Entwuerfe</span>\n                <strong><?= count($entwuerfe) ?></strong>\n            </article>\n        </div>\n    </section>\n\n    <div class=\"wiki-start-layout\">\n        <aside class=\"panel wiki-baum\">\n            <header class=\"panel__kopf\">\n                <div>\n                    <h2>Bereiche</h2>\n                    <p>Wiki-Struktur</p>\n                </div>\n                <?php if (rechte_pruefen('wiki_kategorien_verwalten')): ?>\n                    <a class=\"button button--sekundaer\" href=\"index.php?seite=work_wiki&ansicht=kategorien\">Verwalten</a>\n                <?php endif; ?>\n            </header>\n            <nav class=\"wiki-baum__liste\">\n                <?php foreach ($kategorien as $kategorie): ?>\n                    <a class=\"wiki-baum__eintrag\" href=\"index.php?seite=work_wiki&ansicht=suche&kategorie_id=<?= (int)$kategorie['id'] ?>\">\n                        <span><?= ausgabe($kategorie['name']) ?></span>\n                        <small><?= (int)$kategorie['artikel_anzahl'] ?></small>\n                    </a>\n                <?php endforeach; ?>\n            </nav>\n        </aside>\n\n        <div class=\"wiki-start-main\">\n            <?php if ($angepinnt !== []): ?>\n                <section class=\"panel\">\n                    <header class=\"panel__kopf\">\n                        <div>\n                            <h2>Angepinnt</h2>\n                            <p>Wichtige Artikel fuer schnellen Zugriff.</p>\n                        </div>\n                    </header>\n                    <div class=\"wiki-liste\">\n                        <?php foreach ($angepinnt as $wiki_eintrag): ?>\n                            <?php require __DIR__ . '/work_wiki_teaser.php'; ?>\n                        <?php endforeach; ?>\n                    </div>\n                </section>\n            <?php endif; ?>\n\n            <section class=\"panel\">\n                <header class=\"panel__kopf\">\n                    <div>\n                        <h2>Zuletzt geaendert</h2>\n                        <p>Aktuelle Artikel, Entwuerfe und Arbeitsstaende.</p>\n                    </div>\n                    <span class=\"badge badge--information\"><?= count($veroeffentlicht) ?> veroeffentlicht</span>\n                </header>\n                <div class=\"wiki-liste\">\n                    <?php foreach ($neueste as $wiki_eintrag): ?>\n                        <?php require __DIR__ . '/work_wiki_teaser.php'; ?>\n                    <?php endforeach; ?>\n                </div>\n            </section>\n        </div>\n    </div>\n\n<?php elseif ($wiki_ansicht === 'suche'): ?>\n    <?php\n    $q = validierung_text((string)($_GET['q'] ?? ''), 160);\n    $kategorie_id = (int)($_GET['kategorie_id'] ?? 0);\n    $kategorien = wiki_kategorien_laden();\n    $ergebnisse = $q !== '' ? wiki_artikel_suchen($q, $kategorie_id) : wiki_artikel_liste(['kategorie_id' => $kategorie_id]);\n    ?>\n    <section class=\"panel\">\n        <form class=\"wiki-filter\" action=\"index.php\" method=\"get\">\n            <input type=\"hidden\" name=\"seite\" value=\"work_wiki\">\n            <input type=\"hidden\" name=\"ansicht\" value=\"suche\">\n            <div class=\"formular__feld\">\n                <label for=\"wiki-suche-q\">Suchbegriff</label>\n                <input id=\"wiki-suche-q\" name=\"q\" type=\"search\" value=\"<?= ausgabe($q) ?>\">\n            </div>\n            <div class=\"formular__feld\">\n                <label for=\"wiki-suche-kategorie\">Kategorie</label>\n                <select id=\"wiki-suche-kategorie\" name=\"kategorie_id\">\n                    <option value=\"0\">Alle Kategorien</option>\n                    <?php foreach ($kategorien as $kategorie): ?>\n                        <option value=\"<?= (int)$kategorie['id'] ?>\" <?= $kategorie_id === (int)$kategorie['id'] ? 'selected' : '' ?>><?= ausgabe($kategorie['name']) ?></option>\n                    <?php endforeach; ?>\n                </select>\n            </div>\n            <button class=\"button button--primaer\" type=\"submit\">Suchen</button>\n        </form>\n    </section>\n    <section class=\"panel\">\n        <h2><?= count($ergebnisse) ?> Treffer</h2>\n        <div class=\"wiki-liste\">\n            <?php foreach ($ergebnisse as $wiki_eintrag): ?>\n                <?php require __DIR__ . '/work_wiki_teaser.php'; ?>\n            <?php endforeach; ?>\n            <?php if ($ergebnisse === []): ?>\n                <div class=\"leerzustand\">Keine passenden Wiki-Inhalte gefunden.</div>\n            <?php endif; ?>\n        </div>\n    </section>\n\n<?php elseif ($wiki_ansicht === 'artikel'): ?>\n    <?php\n    $artikel = wiki_artikel_laden((int)($_GET['id'] ?? 0));\n    if (!$artikel || (string)$artikel['status'] === 'archiviert') {\n        echo '<section class=\"panel\"><div class=\"leerzustand\">Artikel wurde nicht gefunden.</div></section>';\n    } else {\n        $anhaenge = wiki_anhaenge_laden((int)$artikel['id']);\n        $toc = wiki_inhaltsverzeichnis((string)$artikel['inhalt']);\n        ?>\n        <div class=\"wiki-artikel-layout\">\n            <article class=\"panel wiki-artikel\">\n                <div class=\"wiki-breadcrumb\"><a href=\"index.php?seite=work_wiki\">Wiki</a> / <span><?= ausgabe((string)$artikel['kategorie_name']) ?></span></div>\n                <div class=\"wiki-artikel__kopf\">\n                    <div>\n                        <h2><?= ausgabe($artikel['titel']) ?></h2>\n                        <p><?= ausgabe($artikel['kurzbeschreibung']) ?></p>\n                    </div>\n                    <span class=\"badge badge--<?= $artikel['status'] === 'veroeffentlicht' ? 'erfolg' : 'warnung' ?>\"><?= ausgabe($artikel['status']) ?></span>\n                </div>\n                <div class=\"wiki-meta\">\n                    <span>Geaendert <?= ausgabe(wiki_datum((int)$artikel['geaendert_am'])) ?></span>\n                    <span><?= ausgabe((string)$artikel['tags']) ?></span>\n                </div>\n                <div class=\"wiki-markdown\"><?= wiki_markdown_rendern((string)$artikel['inhalt']) ?></div>\n            </article>\n            <aside class=\"wiki-seitenleiste\">\n                <section class=\"panel\">\n                    <h3>Aktionen</h3>\n                    <div class=\"wiki-aktionen\">\n                        <?php if (wiki_artikel_darf_bearbeiten($artikel)): ?>\n                            <a class=\"button button--primaer\" href=\"index.php?seite=work_wiki&ansicht=editor&id=<?= (int)$artikel['id'] ?>\">Bearbeiten</a>\n                        <?php endif; ?>\n                        <?php if (rechte_pruefen('wiki_versionen_ansehen')): ?>\n                            <a class=\"button button--sekundaer\" href=\"index.php?seite=work_wiki&ansicht=versionen&id=<?= (int)$artikel['id'] ?>\">Versionen</a>\n                        <?php endif; ?>\n                        <?php if (rechte_pruefen('wiki_artikel_archivieren')): ?>\n                            <form class=\"wiki-aktionen__gefahr\" method=\"post\">\n                                <input type=\"hidden\" name=\"aktion\" value=\"artikel_archivieren\">\n                                <input type=\"hidden\" name=\"id\" value=\"<?= (int)$artikel['id'] ?>\">\n                                <button class=\"button button--gefahr\" type=\"submit\">Archivieren</button>\n                            </form>\n                        <?php endif; ?>\n                    </div>\n                </section>\n                <?php if ($toc !== []): ?>\n                    <section class=\"panel\">\n                        <h3>Inhalt</h3>\n                        <nav class=\"wiki-toc\">\n                            <?php foreach ($toc as $punkt): ?>\n                                <a class=\"wiki-toc__ebene-<?= (int)$punkt['ebene'] ?>\" href=\"#<?= ausgabe($punkt['id']) ?>\"><?= ausgabe($punkt['titel']) ?></a>\n                            <?php endforeach; ?>\n                        </nav>\n                    </section>\n                <?php endif; ?>\n                <section class=\"panel\">\n                    <h3>Anhaenge</h3>\n                    <div class=\"wiki-anhaenge\">\n                        <?php foreach ($anhaenge as $anhang): ?>\n                            <div class=\"wiki-anhang\">\n                                <?php if (str_starts_with((string)$anhang['mime_typ'], 'image/')): ?>\n                                    <img src=\"wiki_download.php?id=<?= (int)$anhang['id'] ?>\" alt=\"\">\n                                <?php endif; ?>\n                                <strong><?= ausgabe($anhang['originalname']) ?></strong>\n                                <small><?= ausgabe($anhang['mime_typ']) ?> · <?= ausgabe(datei_groesse_formatieren((int)$anhang['groesse'])) ?></small>\n                                <a href=\"wiki_download.php?id=<?= (int)$anhang['id'] ?>\">Herunterladen</a>\n                                <?php if (rechte_pruefen('wiki_dateien_loeschen')): ?>\n                                    <form method=\"post\">\n                                        <input type=\"hidden\" name=\"aktion\" value=\"anhang_archivieren\">\n                                        <input type=\"hidden\" name=\"id\" value=\"<?= (int)$anhang['id'] ?>\">\n                                        <input type=\"hidden\" name=\"artikel_id\" value=\"<?= (int)$artikel['id'] ?>\">\n                                        <button class=\"wiki-linkbutton\" type=\"submit\">Archivieren</button>\n                                    </form>\n                                <?php endif; ?>\n                            </div>\n                        <?php endforeach; ?>\n                        <?php if ($anhaenge === []): ?>\n                            <div class=\"leerzustand\">Keine Anhaenge vorhanden.</div>\n                        <?php endif; ?>\n                    </div>\n                </section>\n            </aside>\n        </div>\n    <?php } ?>\n\n<?php elseif ($wiki_ansicht === 'editor'): ?>\n    <?php\n    $artikel = null;\n    if ((int)($_GET['id'] ?? 0) > 0) {\n        $artikel = wiki_artikel_laden((int)$_GET['id']);\n        if (!$artikel || !wiki_artikel_darf_bearbeiten($artikel)) {\n            echo '<section class=\"panel\"><div class=\"leerzustand\">Artikel kann nicht bearbeitet werden.</div></section>';\n            return;\n        }\n    } elseif (!rechte_pruefen('wiki_artikel_anlegen')) {\n        echo '<section class=\"panel\"><div class=\"leerzustand\">Artikel kann nicht angelegt werden.</div></section>';\n        return;\n    }\n    $kategorien = wiki_kategorien_laden();\n    $artikel = $artikel ?: ['id' => 0, 'kategorie_id' => (int)($kategorien[0]['id'] ?? 0), 'titel' => '', 'slug' => '', 'kurzbeschreibung' => '', 'inhalt' => '', 'status' => 'entwurf', 'tags' => '', 'angepinnt' => 0];\n    ?>\n    <form class=\"wiki-editor\" method=\"post\" enctype=\"multipart/form-data\" data-wiki-editor>\n        <input type=\"hidden\" name=\"aktion\" value=\"artikel_speichern\">\n        <input type=\"hidden\" name=\"id\" value=\"<?= (int)$artikel['id'] ?>\">\n        <section class=\"panel wiki-editor__main\">\n            <div class=\"formular__feld\">\n                <label for=\"wiki-titel\">Titel</label>\n                <input id=\"wiki-titel\" name=\"titel\" required maxlength=\"220\" value=\"<?= ausgabe((string)$artikel['titel']) ?>\">\n            </div>\n            <div class=\"formular__feld\">\n                <label for=\"wiki-kurzbeschreibung\">Kurzbeschreibung</label>\n                <textarea id=\"wiki-kurzbeschreibung\" name=\"kurzbeschreibung\" rows=\"3\" maxlength=\"500\"><?= ausgabe((string)$artikel['kurzbeschreibung']) ?></textarea>\n            </div>\n            <div class=\"formular__feld\">\n                <label for=\"wiki-inhalt\">Markdown-Inhalt</label>\n                <textarea id=\"wiki-inhalt\" class=\"wiki-editor__textarea\" name=\"inhalt\" rows=\"20\" required data-wiki-inhalt><?= ausgabe((string)$artikel['inhalt']) ?></textarea>\n            </div>\n            <div class=\"wiki-editor__status\">\n                <span data-wiki-speicherhinweis>Keine ungespeicherten Aenderungen</span>\n                <span data-wiki-wortzahl>0 Woerter</span>\n            </div>\n        </section>\n        <aside class=\"panel wiki-editor__side\">\n            <div class=\"formular__feld\">\n                <label for=\"wiki-kategorie\">Kategorie</label>\n                <select id=\"wiki-kategorie\" name=\"kategorie_id\" required>\n                    <?php foreach ($kategorien as $kategorie): ?>\n                        <option value=\"<?= (int)$kategorie['id'] ?>\" <?= (int)$artikel['kategorie_id'] === (int)$kategorie['id'] ? 'selected' : '' ?>><?= ausgabe($kategorie['name']) ?></option>\n                    <?php endforeach; ?>\n                </select>\n            </div>\n            <div class=\"formular__feld\">\n                <label for=\"wiki-slug\">Slug</label>\n                <input id=\"wiki-slug\" name=\"slug\" value=\"<?= ausgabe((string)$artikel['slug']) ?>\" placeholder=\"automatisch\">\n            </div>\n            <div class=\"formular__feld\">\n                <label for=\"wiki-status\">Status</label>\n                <select id=\"wiki-status\" name=\"status\">\n                    <option value=\"entwurf\" <?= $artikel['status'] === 'entwurf' ? 'selected' : '' ?>>Entwurf</option>\n                    <option value=\"veroeffentlicht\" <?= $artikel['status'] === 'veroeffentlicht' ? 'selected' : '' ?>>Veroeffentlicht</option>\n                </select>\n            </div>\n            <div class=\"formular__feld\">\n                <label for=\"wiki-tags\">Tags</label>\n                <input id=\"wiki-tags\" name=\"tags\" value=\"<?= ausgabe((string)$artikel['tags']) ?>\" placeholder=\"kommagetrennt\">\n            </div>\n            <div class=\"formular__feld\">\n                <label for=\"wiki-notiz\">Aenderungsnotiz</label>\n                <input id=\"wiki-notiz\" name=\"aenderungsnotiz\" value=\"Artikel aktualisiert\">\n            </div>\n            <label class=\"checkbox\">\n                <input type=\"checkbox\" name=\"angepinnt\" value=\"1\" <?= (int)$artikel['angepinnt'] === 1 ? 'checked' : '' ?>>\n                <span>Angepinnt</span>\n            </label>\n            <div class=\"formular__feld\">\n                <label for=\"wiki-anhang\">Anhang</label>\n                <input id=\"wiki-anhang\" name=\"anhang\" type=\"file\">\n            </div>\n            <div class=\"wiki-editor__buttons\">\n                <button class=\"button button--primaer\" type=\"submit\">Speichern</button>\n                <?php if ((int)$artikel['id'] > 0): ?>\n                    <a class=\"button button--sekundaer\" href=\"index.php?seite=work_wiki&ansicht=artikel&id=<?= (int)$artikel['id'] ?>\">Ansehen</a>\n                <?php endif; ?>\n            </div>\n        </aside>\n    </form>\n\n<?php elseif ($wiki_ansicht === 'kategorien'): ?>\n    <?php\n    if (!rechte_pruefen('wiki_kategorien_verwalten')) {\n        echo '<section class=\"panel\"><div class=\"leerzustand\">Keine Berechtigung fuer Kategorien.</div></section>';\n        return;\n    }\n    $kategorien = wiki_kategorien_laden(false);\n    ?>\n    <section class=\"panel\">\n        <h2>Kategorie anlegen</h2>\n        <form class=\"wiki-kategorie-form\" method=\"post\">\n            <input type=\"hidden\" name=\"aktion\" value=\"kategorie_speichern\">\n            <input type=\"hidden\" name=\"id\" value=\"0\">\n            <div class=\"formular__feld\"><label>Name<input name=\"name\" required></label></div>\n            <div class=\"formular__feld\"><label>Slug<input name=\"slug\" placeholder=\"automatisch\"></label></div>\n            <div class=\"formular__feld\">\n                <label>Parent\n                    <select name=\"parent_id\">\n                        <option value=\"0\">Keine Hauptkategorie</option>\n                        <?php foreach ($kategorien as $kategorie): ?>\n                            <option value=\"<?= (int)$kategorie['id'] ?>\"><?= ausgabe($kategorie['name']) ?></option>\n                        <?php endforeach; ?>\n                    </select>\n                </label>\n            </div>\n            <div class=\"formular__feld\">\n                <label>Status\n                    <select name=\"status\"><option value=\"aktiv\">Aktiv</option><option value=\"archiviert\">Archiviert</option></select>\n                </label>\n            </div>\n            <div class=\"formular__feld\"><label>Sortierung<input name=\"sortierung\" type=\"number\" value=\"10\"></label></div>\n            <div class=\"formular__feld wiki-kategorie-form__breit\"><label>Beschreibung<textarea name=\"beschreibung\" rows=\"3\"></textarea></label></div>\n            <button class=\"button button--primaer\" type=\"submit\">Kategorie speichern</button>\n        </form>\n    </section>\n    <section class=\"panel\">\n        <h2>Kategorien</h2>\n        <div class=\"tabelle-wrapper\">\n            <table class=\"tabelle\">\n                <thead><tr><th>Name</th><th>Status</th><th>Artikel</th><th>Sortierung</th></tr></thead>\n                <tbody>\n                <?php foreach ($kategorien as $kategorie): ?>\n                    <tr>\n                        <td><strong><?= ausgabe($kategorie['name']) ?></strong><br><small><?= ausgabe($kategorie['beschreibung']) ?></small></td>\n                        <td><span class=\"badge\"><?= ausgabe($kategorie['status']) ?></span></td>\n                        <td><?= (int)$kategorie['artikel_anzahl'] ?></td>\n                        <td><?= (int)$kategorie['sortierung'] ?></td>\n                    </tr>\n                <?php endforeach; ?>\n                </tbody>\n            </table>\n        </div>\n    </section>\n\n<?php elseif ($wiki_ansicht === 'versionen'): ?>\n    <?php\n    $artikel = wiki_artikel_laden((int)($_GET['id'] ?? 0));\n    if (!$artikel) {\n        echo '<section class=\"panel\"><div class=\"leerzustand\">Artikel wurde nicht gefunden.</div></section>';\n        return;\n    }\n    $versionen = wiki_versionen_laden((int)$artikel['id']);\n    ?>\n    <section class=\"panel\">\n        <div class=\"panel__kopf\">\n            <div>\n                <h2>Versionen: <?= ausgabe($artikel['titel']) ?></h2>\n                <p>Historie und Wiederherstellung des Artikels.</p>\n            </div>\n            <a class=\"button button--sekundaer\" href=\"index.php?seite=work_wiki&ansicht=artikel&id=<?= (int)$artikel['id'] ?>\">Zurueck</a>\n        </div>\n        <div class=\"wiki-versionen\">\n            <?php foreach ($versionen as $version): ?>\n                <article class=\"wiki-version\">\n                    <div>\n                        <strong>Version <?= (int)$version['versionsnummer'] ?></strong>\n                        <p><?= ausgabe($version['aenderungsnotiz']) ?></p>\n                        <?php if ((string)($version['quelle'] ?? '') === 'mcp' && (int)($version['agent_id'] ?? 0) > 0): ?>\n                            <p class=\"wiki-meta\">Geaendert durch Agent: <?= ausgabe((string)($version['akteur_name'] ?: $version['agent_bezeichnung'] ?? '')) ?> ueber MCP-Zugang: <?= ausgabe((string)($version['mcp_benutzer_bezeichnung'] ?? '')) ?></p>\n                        <?php elseif ((string)($version['quelle'] ?? '') === 'mcp'): ?>\n                            <p class=\"wiki-meta\">Geaendert durch MCP-Zugang #<?= (int)($version['mcp_benutzer_id'] ?? 0) ?></p>\n                        <?php elseif ((int)($version['benutzer_id'] ?? $version['erstellt_von'] ?? 0) > 0): ?>\n                            <p class=\"wiki-meta\">Geaendert durch Benutzer #<?= (int)($version['benutzer_id'] ?? $version['erstellt_von']) ?></p>\n                        <?php else: ?>\n                            <p class=\"wiki-meta\">Geaendert durch System</p>\n                        <?php endif; ?>\n                        <small><?= ausgabe(wiki_datum((int)$version['erstellt_am'])) ?></small>\n                    </div>\n                    <details>\n                        <summary>Inhalt ansehen</summary>\n                        <pre><?= ausgabe($version['inhalt']) ?></pre>\n                    </details>\n                    <?php if (rechte_pruefen('wiki_versionen_wiederherstellen')): ?>\n                        <form method=\"post\">\n                            <input type=\"hidden\" name=\"aktion\" value=\"version_wiederherstellen\">\n                            <input type=\"hidden\" name=\"version_id\" value=\"<?= (int)$version['id'] ?>\">\n                            <button class=\"button button--sekundaer\" type=\"submit\">Wiederherstellen</button>\n                        </form>\n                    <?php endif; ?>\n                </article>\n            <?php endforeach; ?>\n        </div>\n    </section>\n<?php endif; ?>\n"
  }
}
