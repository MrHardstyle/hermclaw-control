    "content": "<?php\n/*\nICON: users\nTITLE: Benutzer\nPRIO: 40\nBEREICH: settings\nRECHT: benutzer_anzeigen\n*/\n?>\n<?php\n$meldung = '';\n$totp_setup = [];\n$benutzer_darf_anlegen = rechte_pruefen('system_verwalten');\n$suche = trim((string)($_GET['suche'] ?? '')); // Trimmed search value, max 120 chars\nif ($_SERVER['REQUEST_METHOD'] === 'POST') {\n    csrf_schutz_pruefen();\n    $aktion = (string)($_POST['aktion'] ?? '');\n    if ($aktion === 'speichern' && $benutzer_darf_anlegen) {\n        $id = benutzer_speichern($_POST);\n        $meldung = $id > 0 ? 'Benutzer gespeichert.' : 'Benutzer konnte nicht gespeichert werden.';\n    } elseif ($aktion === 'benutzer_gruppen_speichern' && $benutzer_darf_anlegen) {\n        $benutzer_id = max(0, (int)($_POST['benutzer_id'] ?? 0));\n        $meldung = benutzer_gruppen_speichern($benutzer_id, $_POST['gruppen_ids'] ?? []) ? 'Benutzergruppen gespeichert.' : 'Benutzergruppen konnten nicht gespeichert werden.';\n    } elseif ($aktion === 'gruppe_speichern' && $benutzer_darf_anlegen) {\n        $gruppe_id = benutzer_gruppe_speichern($_POST);\n        $meldung = $gruppe_id > 0 ? 'Gruppe gespeichert.' : 'Gruppe konnte nicht gespeichert werden.';\n    } elseif ($aktion === 'login_sperre_aufheben' && $benutzer_darf_anlegen) {\n        $benutzer_id = max(0, (int)($_POST['benutzer_id'] ?? 0));\n        $meldung = login_sperre_aufheben($benutzer_id) ? 'Login-Sperre aufgehoben.' : 'Login-Sperre konnte nicht aufgehoben werden.';\n    } elseif ($aktion === 'totp_setup_starten' && $benutzer_darf_anlegen) {\n        $benutzer_id = max(0, (int)($_POST['benutzer_id'] ?? 0));\n        $totp_setup = totp_setup_starten($benutzer_id);\n        $meldung = $totp_setup !== [] ? '2FA-Einrichtung gestartet. Secret jetzt in der Authenticator-App hinterlegen.' : '2FA-Einrichtung konnte nicht gestartet werden.';\n    } elseif ($aktion === 'totp_aktivieren' && $benutzer_darf_anlegen) {\n        $benutzer_id = max(0, (int)($_POST['benutzer_id'] ?? 0));\n        $code = (string)($_POST['totp_code'] ?? '');\n        $meldung = totp_setup_aktivieren($benutzer_id, $code) ? '2FA aktiviert.' : '2FA-Code ungueltig oder Einrichtung abgelaufen.';\n    } elseif ($aktion === 'totp_deaktivieren' && $benutzer_darf_anlegen) {\n        $benutzer_id = max(0, (int)($_POST['benutzer_id'] ?? 0));\n        $meldung = totp_deaktivieren($benutzer_id) ? '2FA deaktiviert.' : '2FA konnte nicht deaktiviert werden.';\n    }\n}\n$benutzer_liste = benutzer_array($suche);\n$gruppen = benutzer_gruppen_array();\n$gruppen_alle = benutzer_gruppen_array(false);\n$gruppen_pro_benutzer = benutzer_gruppen_je_benutzer();\n$rechte = rechte_array();\n$rechte_nach_bereich = rechte_nach_bereich($rechte);\n$rechte_pro_gruppe = benutzer_gruppe_rechte_je_gruppe();\n$bereich_label = static function (string $bereich): string {\n    return match ($bereich) {\n        'main' => 'Dashboard',\n        'work' => 'Arbeitsbereich',\n        'control' => 'Kontrolle',\n        'settings' => 'Einstellungen',\n        'api' => 'API',\n        'mcp' => 'MCP',\n        default => ucfirst($bereich),\n    };\n};\n$rechte_checkliste = static function (array $rechte_nach_bereich, array $ausgewaehlt, callable $bereich_label): void {\n    foreach ($rechte_nach_bereich as $bereich => $bereich_rechte) {\n        echo '<fieldset class=\"rechte-gruppe\">';\n        echo '<legend>' . ausgabe($bereich_label((string)$bereich)) . '</legend>';\n        echo '<div class=\"rechte-grid\">';\n        foreach ($bereich_rechte as $recht) {\n            $recht_id = (int)$recht['id'];\n            $checked = in_array($recht_id, $ausgewaehlt, true) ? ' checked' : '';\n            echo '<label class=\"checkbox-zeile rechte-checkbox\">';\n            echo '<input type=\"checkbox\" name=\"rechte_ids[]\" value=\"' . $recht_id . '\"' . $checked . '>';\n            echo '<span><strong>' . ausgabe((string)$recht['bezeichnung']) . '</strong><small>' . ausgabe((string)$recht['key']) . '</small></span>';\n            echo '</label>';\n        }\n        echo '</div>';\n        echo '</fieldset>';\n    }\n};\n?>\n<section class=\"seitenkopf\">\n    <div>\n        <p class=\"seitenkopf__eyebrow\">Einstellungen</p>\n        <h1>Benutzer</h1>\n        <p>Grundlage fuer Web-Benutzer, Gruppen und Berechtigungen.</p>\n    </div>\n    <?php if ($benutzer_darf_anlegen): ?>\n    <div class=\"seitenkopf__aktionen\">\n        <button class=\"button button--primaer\" type=\"button\" data-dialog-open=\"benutzer-dialog\">Benutzer anlegen</button>\n        <button class=\"button button--sekundaer\" type=\"button\" data-dialog-open=\"gruppe-dialog-neu\">Gruppe anlegen</button>\n    </div>\n    <?php endif; ?>\n</section>\n\n<?php if ($meldung !== ''): ?>\n    <div class=\"meldung meldung--warnung\"><?= ausgabe($meldung) ?></div>\n<?php endif; ?>\n\n<?php if ($totp_setup !== []): ?>\n    <section class=\"panel\">\n        <div class=\"panel__kopf\">\n            <div>\n                <span class=\"ui-label\">2FA Einrichtung</span>\n                <h2>Authenticator verbinden</h2>\n                <p>Secret in Aegis, Google Authenticator, Microsoft Authenticator oder 1Password als zeitbasierten Code hinterlegen.</p>\n            </div>\n        </div>\n        <div class=\"anleitung\">\n            <div class=\"formular__feld\">\n                <label>Manueller Secret-Key</label>\n                <input type=\"text\" readonly value=\"<?= ausgabe((string)$totp_setup['secret']) ?>\">\n            </div>\n            <pre class=\"codeblock\"><code><?= ausgabe((string)$totp_setup['uri']) ?></code></pre>\n            <p class=\"tabelle__meta\">Danach in der passenden Benutzerzeile den aktuellen 6-stelligen Code eingeben und 2FA aktivieren.</p>\n        </div>\n    </section>\n<?php endif; ?>\n\n<section class=\"datentabelle\">\n    <header class=\"datentabelle__toolbar\">\n        <div>\n            <strong>Benutzerliste</strong>\n            <p>Web-Zugaenge, Status und letzte Anmeldung aus der Datenbank.</p>\n        </div>\n        <form class=\"formular formular--inline\" method=\"get\">\n            <input type=\"search\" name=\"suche\" value=\"<?= ausgabe($suche) ?>\" maxlength=\"120\" placeholder=\"Benutzer suchen\">\n        </form>\n        <?php if ($benutzer_darf_anlegen): ?>\n            <button class=\"button button--sekundaer\" type=\"button\" data-dialog-open=\"benutzer-dialog\">Neu</button>\n        <?php endif; ?>\n    </header>\n    <div class=\"datentabelle__scrollbereich\">\n        <table class=\"tabelle\">\n            <thead>\n                <tr>\n                    <th>Benutzer</th>\n                    <th>E-Mail-Adresse</th>\n                    <th>Gruppen</th>\n                    <th>Status</th>\n                    <th>2FA</th>\n                    <th>Letzte Anmeldung</th>\n                    <th>Aktionen</th>\n                </tr>\n            </thead>\n            <tbody>\n                <?php foreach ($benutzer_liste as $benutzer): ?>\n                    <?php $login_sperre = login_sperre_status((int)$benutzer['id']); ?>\n                    <tr>\n                        <td>\n                            <strong><?= ausgabe((string)($benutzer['anzeigename'] ?: $benutzer['benutzername'])) ?></strong><br>\n                            <span class=\"tabelle__meta\"><?= ausgabe((string)$benutzer['benutzername']) ?></span>\n                        </td>\n                        <td><?= ausgabe((string)$benutzer['email']) ?></td>\n                        <td>\n                            <div class=\"badge-liste\">\n                                <?php foreach (($gruppen_pro_benutzer[(int)$benutzer['id']] ?? []) as $gruppe): ?>\n                                    <span class=\"badge <?= (int)$gruppe['aktiv'] === 1 ? 'badge--information' : 'badge--warnung' ?>\"><?= ausgabe((string)$gruppe['bezeichnung']) ?></span>\n                                <?php endforeach; ?>\n                                <?php if (empty(