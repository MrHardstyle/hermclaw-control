) ?> Gruppen, <?= count($rechte) ?> Rechte</footer>\n</section>\n\n<?php if ($benutzer_darf_anlegen): ?>\n<dialog class=\"ui-dialog\" id=\"benutzer-dialog\" aria-labelledby=\"benutzer-dialog-title\">\n    <div class=\"ui-dialog__kopf\">\n        <div>\n            <span class=\"ui-label\">Neuer Benutzer</span>\n            <h2 id=\"benutzer-dialog-title\">Benutzer anlegen</h2>\n            <p>Der Zugang wird direkt in der Datenbank gespeichert. Das Passwort wird gehasht abgelegt.</p>\n        </div>\n        <button class=\"icon-button icon-button--sichtbar\" type=\"button\" data-dialog-close aria-label=\"Dialog schliessen\">\n            <span class=\"icon icon--close\"></span>\n        </button>\n    </div>\n    <form class=\"formular formular--breit ui-dialog__inhalt\" method=\"post\">\n        <input type=\"hidden\" name=\"aktion\" value=\"speichern\">\n        <div class=\"formular__feld\">\n            <label for=\"benutzer-benutzername\">Benutzername *</label>\n            <input id=\"benutzer-benutzername\" name=\"benutzername\" required aria-required=\"true\" autocomplete=\"username\">\n        </div>\n        <div class=\"formular__feld\">\n            <label for=\"benutzer-email\">E-Mail-Adresse *</label>\n            <input id=\"benutzer-email\" name=\"email\" type=\"email\" required aria-required=\"true\" autocomplete=\"email\">\n        </div>\n        <div class=\"formular__feld\">\n            <label for=\"benutzer-vorname\">Vorname</label>\n            <input id=\"benutzer-vorname\" name=\"vorname\" autocomplete=\"given-name\">\n        </div>\n        <div class=\"formular__feld\">\n            <label for=\"benutzer-nachname\">Nachname</label>\n            <input id=\"benutzer-nachname\" name=\"nachname\" autocomplete=\"family-name\">\n        </div>\n        <div class=\"formular__feld\">\n            <label for=\"benutzer-anzeigename\">Anzeigename</label>\n            <input id=\"benutzer-anzeigename\" name=\"anzeigename\" autocomplete=\"name\">\