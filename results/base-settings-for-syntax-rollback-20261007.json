uppen_pro_benutzer[(int)$benutzer['id']] ?? [], 'id')); ?>\n    <dialog class=\"ui-dialog\" id=\"benutzer-gruppen-dialog-<?= (int)$benutzer['id'] ?>\" aria-labelledby=\"benutzer-gruppen-title-<?= (int)$benutzer['id'] ?>\">\n        <div class=\"ui-dialog__kopf\">\n            <div>\n                <span class=\"ui-label\">Zugriff</span>\n                <h2 id=\"benutzer-gruppen-title-<?= (int)$benutzer['id'] ?>\"><?= ausgabe((string)($benutzer['anzeigename'] ?: $benutzer['benutzername'])) ?></h2>\n                <p>Der Benutzer erhaelt alle Rechte aus den ausgewaehlten Gruppen.</p>\n            </div>\n            <button class=\"icon-button icon-button--sichtbar\" type=\"button\" data-dialog-close aria-label=\"Dialog schliessen\">\n                <span class=\"icon icon--close\"></span>\n            </button>\n        </div>\n        <form class=\"formular ui-dialog__inhalt\" method=\"post\">\n            <input type=\"hidden\" name=\"aktion\" value=\"benutzer_gruppen_speichern\">\n            <input type=\"hidden\" name=\"benutzer_id\" value=\"<?= (int)$benutzer['id'] ?>\">\n            <div class=\"auswahl-grid auswahl-grid--gruppen\">\n                <?php foreach ($gruppen as $gruppe): ?>\n                    <label class=\"checkbox-zeile\">\n                        <input type=\"checkbox\" name=\"gruppen_ids[]\" value=\"<?= (int)$gruppe['id'] ?>\" <?= in_array((int)$gruppe['id'], $benutzer_gruppen_ids, true) ? 'checked' : '' ?>>\n                        <span>\n                            <strong><?= ausgabe((string)$gruppe['bezeichnung']) ?></strong>\n                            <?php if ((string)$gruppe['beschreibung'] !== ''): ?>\n                                <small><?= ausgabe((string)$gruppe['beschreibung']) ?></small>\n                            <?php endif; ?>\n                        </span>\n                    </label>\n                <?php endforeach; ?>\n            </div>\n            <div class=\"ui-dialog__aktionen\">\n                