ass=\"badge badge--warnung\">Einrichtung offen</span>\n                            <?php else: ?>\n                                <span class=\"badge badge--information\">Aus</span>\n                            <?php endif; ?>\n                        </td>\n                        <td><?= (int)$benutzer['letzte_anmeldung'] > 0 ? date('d.m.Y H:i', (int)$benutzer['letzte_anmeldung']) : 'Noch nie' ?></td>\n                        <td>\n                            <?php if ($benutzer_darf_anlegen): ?>\n                                <button class=\"button button--sekundaer\" type=\"button\" data-dialog-open=\"benutzer-gruppen-dialog-<?= (int)$benutzer['id'] ?>\">Zugriff</button>\n                            <?php endif; ?>\n                            <?php if ($benutzer_darf_anlegen && ($login_sperre['aktiv'] || (int)$login_sperre['fehlversuche'] > 0)): ?>\n                                <form method=\"post\">\n                                    <input type=\"hidden\" name=\"aktion\" value=\"login_sperre_aufheben\">\n                                    <input type=\"hidden\" name=\"benutzer_id\" value=\"<?= (int)$benutzer['id'] ?>\">\n                                    <button class=\"button button--sekundaer\" type=\"submit\">Entsperren</button>\n                                </form>\n                            <?php endif; ?>\n                            <?php if ($benutzer_darf_anlegen && totp_aktiv($benutzer)): ?>\n                                <form method=\"post\">\n                                    <input type=\"hidden\" name=\"aktion\" value=\"totp_deaktivieren\">\n                                    <input type=\"hidden\" name=\"benutzer_id\" value=\"<?= (int)$benutzer['id'] ?>\">\n                                    <button class=\"button button--gefahr\" type=\"submit\">2FA aus</button>\n                                </form>\n                            <?php elseif ($benutzer_darf_anlegen && trim((string)($benutzer['totp_pending_secret'] ?? '')) !== ''): ?>\n                                <form class=\"formular formular--inline\" method=\"post\">\n                                    <input type=\"hidden\" name=\"aktion\" value=\"totp_aktivieren\">\n                                    <input type=\"hidden\" name=\"benutzer_id\" value=\"<?= (int)$benutzer['id'] ?>\">\n                                    <input name=\"totp_code\" type=\"text\" inputmode=\"numeric\" pattern=\"[0-9]{6}\" maxlength=\"6\" placeholder=\"123456\" required aria-label=\"2FA-Code\">\n                                    <button class=\"button button--primaer\" type=\"submit\">2FA aktivieren</button>\n                                </form>\n                                <form method=\"post\">\n                                    <input type=\"hidden\" name=\"aktion\" value=\"totp_setup_starten\">\n                                    <input type=\"hidden\" name=\"benutzer_id\" value=\"<?= (int)$benutzer['id'] ?>\">\n                                    <button class=\"button button--sekundaer\" type=\"submit\">Secret neu</button>\n                                </form>\n                            <?php elseif ($benutzer_darf_anlegen): ?>\n                                <form method=\"post\">\n                                    <input type=\"hidden\" name=\"aktion\" value=\"totp_setup_starten\">\n                                    <input type=\"hidden\" name=\"benutzer_id\" value=\"<?= (int)$benutzer['id'] ?>\">\n                                    <button class=\"button button--sekundaer\" type=\"submit\">2FA einrichten</button>\n                                </form>\n                            <?php else: ?>\n                                <button class=\"button button--sekundaer\" type=\"button\">Oeffnen</button>\n                            <?php endif; ?>\n                        </td>\n                    </tr>\n                <?php endforeach; ?>\n                <?php if ($suche !== '' && $benutzer_liste === []): ?